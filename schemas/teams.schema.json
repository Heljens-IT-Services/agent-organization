{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heljens:teams:1",
  "type": "object", "additionalProperties": false,
  "required": ["teams"],
  "properties": {
    "teams": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["team_id", "name", "description", "tasks", "leader_id", "role_file"],
        "properties": {
          "team_id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/text"},
          "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
          "leader_id": {"type": "string", "pattern": "^teamleiter_[a-z][a-z0-9_]*$"},
          "role_file": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^teamleiter_[a-z][a-z0-9_]*\\.toml$"}]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
