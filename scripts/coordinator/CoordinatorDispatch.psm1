. (Join-Path $PSScriptRoot 'Lifecycle.Persistence.ps1')
Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
$script:DispatchUtf8=New-Object System.Text.UTF8Encoding($false,$true)
function Invoke-CoordinatorDispatchLock([string]$Path,[scriptblock]$Action,[int]$TimeoutMilliseconds=5000){$p=[IO.Path]::GetFullPath($Path);$d=[IO.Path]::GetDirectoryName($p);if(-not [IO.Directory]::Exists($d)){[void][IO.Directory]::CreateDirectory($d)};$sw=[Diagnostics.Stopwatch]::StartNew();$l=$null;while(-not $l){try{$l=New-Object IO.FileStream($p+'.lock',[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)}catch [IO.IOException]{if($sw.ElapsedMilliseconds -ge $TimeoutMilliseconds){throw 'DispatchJournalBusy'};Start-Sleep -Milliseconds 50}};try{$j=if([IO.File]::Exists($p)){[IO.File]::ReadAllText($p,$script:DispatchUtf8)|ConvertFrom-Json -ErrorAction Stop}else{[pscustomobject]@{schemaVersion='1.0';executions=@()}};if($j.schemaVersion -cne '1.0' -or $null -eq $j.executions){throw 'InvalidDispatchJournal'};$j=Read-LCArchive $p $j;& $Action $p $j}finally{$l.Dispose()}}
function Write-CoordinatorDispatchJournal([string]$Path,$Journal){Write-LCJournal $Path $Journal}

function Get-CoordinatorDispatchIdentity([string]$WorkItemId,[string]$Purpose,[int]$Generation){if([string]::IsNullOrWhiteSpace($WorkItemId)-or[string]::IsNullOrWhiteSpace($Purpose)-or$Generation -lt 1){throw 'InvalidDispatchIdentity'};$raw=$WorkItemId+"`n"+$Purpose+"`n"+$Generation;$h=[Security.Cryptography.SHA256]::Create();try{$bytes=$h.ComputeHash($script:DispatchUtf8.GetBytes($raw))}finally{$h.Dispose()};$guidBytes=New-Object byte[] 16;[Array]::Copy($bytes,$guidBytes,16);$guidBytes[7]=($guidBytes[7] -band 0x0f) -bor 0x50;$guidBytes[8]=($guidBytes[8] -band 0x3f) -bor 0x80;$base=[Guid]::new($guidBytes).ToString('D');return [pscustomobject]@{ExecutionId=$base;TaskId=$base;RequestId=$base}}
function Start-CoordinatorDispatch{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$WorkItemId,[Parameter(Mandatory=$true)][string]$Purpose,[Parameter(Mandatory=$true)][ValidateRange(1,2147483647)][int]$Generation,[Parameter(Mandatory=$true)]$Input,[string[]]$EventIds=@());$ident=Get-CoordinatorDispatchIdentity $WorkItemId $Purpose $Generation;$json=ConvertTo-Json -InputObject $Input -Depth 50 -Compress;$sha=[Security.Cryptography.SHA256]::Create();try{$inputHash=([BitConverter]::ToString($sha.ComputeHash($script:DispatchUtf8.GetBytes($json)))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()};Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$hits=@($j.executions|Where-Object{$_.executionId -ceq $ident.ExecutionId});if($hits.Count -gt 1){throw 'DispatchIdentityAmbiguous'};if($hits.Count){$x=$hits[0];if($x.inputHash -cne $inputHash){throw 'DispatchInputConflict'};if($x.state -in @('Running','RecoveryRequired')){throw 'DispatchRecoveryRequired'};return $x};$x=[pscustomobject]@{executionId=$ident.ExecutionId;taskId=$ident.TaskId;requestId=$ident.RequestId;workItemId=$WorkItemId;purpose=$Purpose;generation=$Generation;inputHash=$inputHash;input=$Input;eventIds=@($EventIds|Select-Object -Unique);state='Prepared';createdAtUtc=[DateTime]::UtcNow.ToString('o');updatedAtUtc=[DateTime]::UtcNow.ToString('o');launchIntentAtUtc=$null;launchBinding=$null;runningAtUtc=$null;returnedAtUtc=$null;recoveryRequiredAtUtc=$null;terminalDecision=$null;effects=@();returnValue=$null};$j.executions=@($j.executions)+@($x);Write-CoordinatorDispatchJournal $p $j;return $x}}
function Set-CoordinatorDispatchState{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$ExecutionId,[Parameter(Mandatory=$true)][ValidateSet('LaunchIntent','Running','Returned','RecoveryRequired')][string]$State,[string]$LaunchBinding,$TerminalDecision,[object[]]$Effects=@(),$ReturnValue);Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$xs=@($j.executions|Where-Object{$_.executionId -ceq $ExecutionId});if($xs.Count -ne 1){throw 'DispatchNotFound'};$x=$xs[0];foreach($name in @('launchIntentAtUtc','runningAtUtc','returnedAtUtc','recoveryRequiredAtUtc')){if(-not $x.PSObject.Properties[$name]){$x|Add-Member -NotePropertyName $name -NotePropertyValue $null}};$allowed=@{Prepared=@('LaunchIntent','RecoveryRequired');LaunchIntent=@('Running','RecoveryRequired');Running=@('Returned','RecoveryRequired');RecoveryRequired=@('Running','Returned');Returned=@()};if($x.state -ceq $State){return $x};if($allowed[$x.state] -notcontains $State){throw 'DispatchTransitionInvalid'};$now=[DateTime]::UtcNow.ToString('o');if($State -ceq 'LaunchIntent'){$x.launchIntentAtUtc=$now};if($State -ceq 'Running' -and -not $LaunchBinding -and -not $x.launchBinding){throw 'DispatchLaunchBindingRequired'};if($LaunchBinding){$x.launchBinding=$LaunchBinding};if($State -ceq 'Running'){$x.runningAtUtc=$now};if($State -ceq 'RecoveryRequired'){$x.recoveryRequiredAtUtc=$now};if($State -ceq 'Returned'){$x.returnedAtUtc=$now;$x.terminalDecision=$TerminalDecision;$x.effects=@($Effects);$x.returnValue=$ReturnValue};$x.state=$State;$x.updatedAtUtc=$now;Write-CoordinatorDispatchJournal $p $j;return $x}}
function Get-CoordinatorDispatch{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$ExecutionId);Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$x=@($j.executions|Where-Object{$_.executionId -ceq $ExecutionId});if($x.Count -ne 1){return $null};return $x[0]}}
function Complete-CoordinatorPrestartDispatch {
    [CmdletBinding()]param(
        [Parameter(Mandatory)][string]$JournalPath,[Parameter(Mandatory)][string]$ExecutionId,
        [Parameter(Mandatory)][string]$TaskId,[Parameter(Mandatory)][string]$WorkItemId,
        [Parameter(Mandatory)][string]$PayloadHash,[Parameter(Mandatory)][string]$ParentContextHash,
        [Parameter(Mandatory)][string]$StartIntentHash,[Parameter(Mandatory)][string]$ResultPath,
        [Parameter(Mandatory)][string]$ResultHash,[Parameter(Mandatory)][string]$NoSpawnReceiptPath,
        [Parameter(Mandatory)][string]$NoSpawnReceiptHash,[Parameter(Mandatory)][string]$FailureCommitPath,
        [Parameter(Mandatory)][string]$FailureCommitHash,[Parameter(Mandatory)][string]$RepositoryRoot
    )
    $rm=Import-Module (Join-Path $PSScriptRoot '..\workitems\WorkItemPrestartRecovery.psm1') -PassThru -Force
    Invoke-CoordinatorDispatchLock $JournalPath {
        param($p,$j)
        $g=& $rm {param($p,$h,$c,$ch,$repo)Assert-PrestartFailureCommit $p $h $c $ch $repo} $NoSpawnReceiptPath $NoSpawnReceiptHash $FailureCommitPath $FailureCommitHash $RepositoryRoot
        $r=$g.receipt
        $xs=@($j.executions|Where-Object{$_.executionId -ceq $ExecutionId});if($xs.Count -ne 1){throw 'DispatchNotFound'};$x=$xs[0]
        if($r.executionId -cne $ExecutionId -or $r.taskId -cne ([guid]$TaskId).ToString('N') -or $r.workItemId -cne $WorkItemId -or $r.payloadHash -cne $PayloadHash -or $r.parentContextHash -cne $ParentContextHash -or $r.startIntentHash -cne $StartIntentHash -or $r.resultHash -cne $ResultHash -or $r.resultPath -cne [IO.Path]::GetFullPath($ResultPath) -or $r.dispatchJournalPath -cne $p){throw 'DispatchCallerReceiptConflict'}
        if($x.launchBinding -or $x.runningAtUtc -or ([guid]$x.taskId).ToString('N') -cne $r.taskId -or $x.workItemId -cne $r.workItemId -or $x.input.payloadHash -cne $r.payloadHash -or $x.input.parentContextHash -cne $r.parentContextHash -or $x.input.authorityHash -cne $r.startIntentHash -or [IO.Path]::GetFullPath($x.input.resultPath) -cne $r.resultPath){throw 'DispatchLaunchOrIdentityConflict'}
        $v=[ordered]@{taskId=$r.taskId;resultPath=$r.resultPath;resultHash=$r.resultHash;noSpawnReceiptPath=[IO.Path]::GetFullPath($NoSpawnReceiptPath);noSpawnReceiptHash=$NoSpawnReceiptHash;failureCommitPath=[IO.Path]::GetFullPath($FailureCommitPath);failureCommitHash=$FailureCommitHash;payloadHash=$r.payloadHash;parentContextHash=$r.parentContextHash;startIntentHash=$r.startIntentHash;startAttemptHash=$r.startAttemptHash;noSpawnAttemptHash=$r.noSpawnAttemptHash}
        if($x.state -ceq 'Returned'){
            $same=& $rm {param($a,$b)(Get-RecoveryHash (ConvertTo-RecoveryBytes $a)) -ceq (Get-RecoveryHash (ConvertTo-RecoveryBytes $b))} $x.returnValue $v
            if($x.terminalDecision -cne 'prestart-failed' -or -not $same){throw 'PrestartDispatchReplayConflict'};return $x
        }
        if($x.state -notin @('Prepared','LaunchIntent','RecoveryRequired')){throw 'PrestartDispatchStateClosed'}
        # LaunchIntent alone proves nothing. Verified immutable NoSpawn proof is required above.
        $x.state='Returned';$x.terminalDecision='prestart-failed';$x.returnValue=$v;$x.launchBinding=$null
        $x.returnedAtUtc=[DateTime]::UtcNow.ToString('o');$x.updatedAtUtc=$x.returnedAtUtc
        & $rm {param($p,$j)Write-RecoveryBytes $p (ConvertTo-RecoveryBytes $j)} $p $j;return $x
    }
}
Export-ModuleMember -Function Get-CoordinatorDispatchIdentity,Start-CoordinatorDispatch,Set-CoordinatorDispatchState,Get-CoordinatorDispatch,Complete-CoordinatorPrestartDispatch
