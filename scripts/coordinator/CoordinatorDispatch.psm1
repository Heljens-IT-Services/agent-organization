Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
$script:DispatchUtf8=New-Object System.Text.UTF8Encoding($false,$true)
function Invoke-CoordinatorDispatchLock([string]$Path,[scriptblock]$Action,[int]$TimeoutMilliseconds=5000){$p=[IO.Path]::GetFullPath($Path);$d=[IO.Path]::GetDirectoryName($p);if(-not [IO.Directory]::Exists($d)){[void][IO.Directory]::CreateDirectory($d)};$sw=[Diagnostics.Stopwatch]::StartNew();$l=$null;while(-not $l){try{$l=New-Object IO.FileStream($p+'.lock',[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)}catch [IO.IOException]{if($sw.ElapsedMilliseconds -ge $TimeoutMilliseconds){throw 'DispatchJournalBusy'};Start-Sleep -Milliseconds 50}};try{$j=if([IO.File]::Exists($p)){[IO.File]::ReadAllText($p,$script:DispatchUtf8)|ConvertFrom-Json -ErrorAction Stop}else{[pscustomobject]@{schemaVersion='1.0';executions=@()}};if($j.schemaVersion -cne '1.0' -or $null -eq $j.executions){throw 'InvalidDispatchJournal'};& $Action $p $j}finally{$l.Dispose()}}
function Write-CoordinatorDispatchJournal([string]$Path,$Journal){$t=$Path+'.'+[guid]::NewGuid().ToString('N')+'.writing';try{[IO.File]::WriteAllText($t,(ConvertTo-Json -InputObject $Journal -Depth 50 -Compress),$script:DispatchUtf8);if([IO.File]::Exists($Path)){[IO.File]::Replace($t,$Path,$null)}else{[IO.File]::Move($t,$Path)}}finally{if([IO.File]::Exists($t)){[IO.File]::Delete($t)}}}
function Get-CoordinatorDispatchIdentity([string]$WorkItemId,[string]$Purpose,[int]$Generation){if([string]::IsNullOrWhiteSpace($WorkItemId)-or[string]::IsNullOrWhiteSpace($Purpose)-or$Generation -lt 1){throw 'InvalidDispatchIdentity'};$raw=$WorkItemId+"`n"+$Purpose+"`n"+$Generation;$h=[Security.Cryptography.SHA256]::Create();try{$base=([BitConverter]::ToString($h.ComputeHash($script:DispatchUtf8.GetBytes($raw)))).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()};return [pscustomobject]@{ExecutionId=$base;TaskId='task-'+$base;RequestId='request-'+$base}}
function Start-CoordinatorDispatch{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$WorkItemId,[Parameter(Mandatory=$true)][string]$Purpose,[Parameter(Mandatory=$true)][ValidateRange(1,2147483647)][int]$Generation,[Parameter(Mandatory=$true)]$Input,[string[]]$EventIds=@());$ident=Get-CoordinatorDispatchIdentity $WorkItemId $Purpose $Generation;$json=ConvertTo-Json -InputObject $Input -Depth 50 -Compress;$sha=[Security.Cryptography.SHA256]::Create();try{$inputHash=([BitConverter]::ToString($sha.ComputeHash($script:DispatchUtf8.GetBytes($json)))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()};Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$hits=@($j.executions|Where-Object{$_.executionId -ceq $ident.ExecutionId});if($hits.Count){$x=$hits[0];if($x.inputHash -cne $inputHash){throw 'DispatchInputConflict'};if($x.state -in @('LaunchIntent','Running','RecoveryRequired')){throw 'DispatchRecoveryRequired'};return $x};$x=[pscustomobject]@{executionId=$ident.ExecutionId;taskId=$ident.TaskId;requestId=$ident.RequestId;workItemId=$WorkItemId;purpose=$Purpose;generation=$Generation;inputHash=$inputHash;input=$Input;eventIds=@($EventIds|Select-Object -Unique);state='Prepared';createdAtUtc=[DateTime]::UtcNow.ToString('o');updatedAtUtc=[DateTime]::UtcNow.ToString('o');launchBinding=$null;terminalDecision=$null;effects=@();returnValue=$null};$j.executions=@($j.executions)+@($x);Write-CoordinatorDispatchJournal $p $j;return $x}}
function Set-CoordinatorDispatchState{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$ExecutionId,[Parameter(Mandatory=$true)][ValidateSet('LaunchIntent','Running','Returned','RecoveryRequired')][string]$State,[string]$LaunchBinding,$TerminalDecision,[object[]]$Effects=@(),$ReturnValue);Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$xs=@($j.executions|Where-Object{$_.executionId -ceq $ExecutionId});if($xs.Count -ne 1){throw 'DispatchNotFound'};$x=$xs[0];$allowed=@{Prepared=@('LaunchIntent');LaunchIntent=@('Running','RecoveryRequired');Running=@('Returned','RecoveryRequired');RecoveryRequired=@('Running','Returned');Returned=@()};if($x.state -ceq $State){return $x};if($allowed[$x.state] -notcontains $State){throw 'DispatchTransitionInvalid'};if($State -ceq 'LaunchIntent'){$x.launchIntentAtUtc=[DateTime]::UtcNow.ToString('o')};if($State -ceq 'Running' -and -not $LaunchBinding -and -not $x.launchBinding){throw 'DispatchLaunchBindingRequired'};if($LaunchBinding){$x.launchBinding=$LaunchBinding};if($State -ceq 'Returned'){$x.terminalDecision=$TerminalDecision;$x.effects=@($Effects);$x.returnValue=$ReturnValue};$x.state=$State;$x.updatedAtUtc=[DateTime]::UtcNow.ToString('o');Write-CoordinatorDispatchJournal $p $j;return $x}}
function Get-CoordinatorDispatch{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$JournalPath,[Parameter(Mandatory=$true)][string]$ExecutionId);Invoke-CoordinatorDispatchLock $JournalPath {param($p,$j)$x=@($j.executions|Where-Object{$_.executionId -ceq $ExecutionId});if($x.Count -ne 1){return $null};return $x[0]}}
Export-ModuleMember -Function Get-CoordinatorDispatchIdentity,Start-CoordinatorDispatch,Set-CoordinatorDispatchState,Get-CoordinatorDispatch
