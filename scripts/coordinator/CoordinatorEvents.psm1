. (Join-Path $PSScriptRoot 'Failure.Events.ps1')
. (Join-Path $PSScriptRoot 'Lifecycle.Persistence.ps1')
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$script:EventUtf8 = New-Object System.Text.UTF8Encoding($false, $true)

function Invoke-CoordinatorEventStoreLock {
    param([string]$Path, [scriptblock]$Action, [int]$TimeoutMilliseconds = 5000)
    $full=[IO.Path]::GetFullPath($Path); $dir=[IO.Path]::GetDirectoryName($full)
    if(-not [IO.Directory]::Exists($dir)){throw 'EventDirectoryMissing'}
    $watch=[Diagnostics.Stopwatch]::StartNew(); $lock=$null
    while(-not $lock){try{$lock=New-Object IO.FileStream($full+'.lock',[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)}catch [IO.IOException]{if($watch.ElapsedMilliseconds -ge $TimeoutMilliseconds){throw 'EventStoreBusy'};Start-Sleep -Milliseconds 50}}
    try{$store=if([IO.File]::Exists($full)){[IO.File]::ReadAllText($full,$script:EventUtf8)|ConvertFrom-Json -ErrorAction Stop}else{[pscustomobject]@{schemaVersion='1.0';events=@()}};if($store.schemaVersion -cne '1.0' -or $null -eq $store.events){throw 'InvalidEventStore'};$store=Read-LCArchive $full $store;& $Action $full $store}finally{$lock.Dispose()}
}
function Write-CoordinatorEventStore([string]$Path,$Store,[switch]$Durable){Write-LCJournal $Path $Store}

function Get-CoordinatorEventHash($Value){$json=ConvertTo-Json -InputObject $Value -Depth 40 -Compress;$sha=[Security.Cryptography.SHA256]::Create();try{return ([BitConverter]::ToString($sha.ComputeHash($script:EventUtf8.GetBytes($json)))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()}}
function Publish-CoordinatorEvent {
 [CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[Parameter(Mandatory=$true)][ValidateSet('workitem_changed','return_received','human_response','reminder_due')][string]$Kind,[Parameter(Mandatory=$true)][string]$SourceId,[Parameter(Mandatory=$true)]$Payload,[switch]$Durable)
 if([string]::IsNullOrWhiteSpace($SourceId)){throw 'EventSourceIdRequired'};$idHash=[Security.Cryptography.SHA256]::Create();try{$id=([BitConverter]::ToString($idHash.ComputeHash($script:EventUtf8.GetBytes($Kind+"`n"+$SourceId)))).Replace('-','').ToLowerInvariant()}finally{$idHash.Dispose()};$payloadHash=Get-CoordinatorEventHash $Payload
 Invoke-CoordinatorEventStoreLock $Path {param($full,$store)$found=@($store.events|Where-Object{$_.id -ceq $id});if($found.Count -gt 1){throw 'EventIdentityConflict'};if($found.Count -eq 1){$e=$found[0];if($e.kind -cne $Kind -or $e.sourceId -cne $SourceId -or $e.payloadHash -cne $payloadHash){throw 'EventIdentityPayloadConflict'};return $e};$event=[pscustomobject]@{id=$id;kind=$Kind;sourceId=$SourceId;payload=$Payload;payloadHash=$payloadHash;state='pending';claimId=$null;claimedAtUtc=$null;leaseUntilUtc=$null;acknowledgedAtUtc=$null;createdAtUtc=[DateTime]::UtcNow.ToString('o')};$store.events=@($store.events)+@($event);Write-CoordinatorEventStore $full $store -Durable:$Durable;return $event}
}
function Add-CoordinatorEvent { [CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[Parameter(Mandatory=$true)][ValidateSet('workitem_changed','return_received','human_response','reminder_due')][string]$Kind,[Parameter(Mandatory=$true)][string]$SourceId,[Parameter(Mandatory=$true)]$Payload,[switch]$Durable);Publish-CoordinatorEvent @PSBoundParameters }
function Get-CoordinatorPendingEvents{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[ValidateRange(1,1000)][int]$Limit=100);Invoke-CoordinatorEventStoreLock $Path {param($f,$s)return ,@($s.events|Where-Object{$_.state -ceq 'pending' -and (Test-LCEventDue $_ ([DateTime]::UtcNow))}|Select-Object -First $Limit)}}
function Claim-CoordinatorEvents{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[string]$ClaimId=([guid]::NewGuid().ToString('N')),[ValidateRange(1,100)][int]$Limit=20,[ValidateRange(1,3600)][int]$LeaseSeconds=60);if([string]::IsNullOrWhiteSpace($ClaimId)){throw 'EventClaimIdRequired'};Invoke-CoordinatorEventStoreLock $Path {param($full,$store)$now=[DateTime]::UtcNow;$claimed=@();foreach($e in @($store.events)){if($e.state -ceq 'claimed' -and $e.leaseUntilUtc -and [DateTimeOffset]::Parse([string]$e.leaseUntilUtc).UtcDateTime -le $now){$e.state='pending';$e.claimId=$null;$e.claimedAtUtc=$null;$e.leaseUntilUtc=$null};if($e.state -ceq 'pending' -and (Test-LCEventDue $e $now) -and $claimed.Count -lt $Limit){$e.state='claimed';$e.claimId=$ClaimId;$e.claimedAtUtc=$now.ToString('o');$e.leaseUntilUtc=$now.AddSeconds($LeaseSeconds).ToString('o');$claimed+= $e}};if($claimed.Count){Write-CoordinatorEventStore $full $store};return ,$claimed}}
function Claim-CoordinatorEvent{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[Parameter(Mandatory=$true)][string]$EventId,[Parameter(Mandatory=$true)][string]$ClaimId,[ValidateRange(1,3600)][int]$LeaseSeconds=60);if([string]::IsNullOrWhiteSpace($ClaimId)){throw 'EventClaimIdRequired'};Invoke-CoordinatorEventStoreLock $Path {param($full,$store)$now=[DateTime]::UtcNow;$matches=@($store.events|Where-Object{$_.id -ceq $EventId});if($matches.Count -ne 1){throw 'EventClaimUnavailable'};$e=$matches[0];if($e.state -ceq 'claimed' -and $e.leaseUntilUtc -and [DateTimeOffset]::Parse([string]$e.leaseUntilUtc).UtcDateTime -le $now){$e.state='pending';$e.claimId=$null;$e.claimedAtUtc=$null;$e.leaseUntilUtc=$null};if($e.state -ceq 'claimed' -and $e.claimId -ceq $ClaimId){$e.leaseUntilUtc=$now.AddSeconds($LeaseSeconds).ToString('o');Write-CoordinatorEventStore $full $store;return $e};if($e.state -cne 'pending' -or -not (Test-LCEventDue $e $now)){throw 'EventClaimUnavailable'};$e.state='claimed';$e.claimId=$ClaimId;$e.claimedAtUtc=$now.ToString('o');$e.leaseUntilUtc=$now.AddSeconds($LeaseSeconds).ToString('o');Write-CoordinatorEventStore $full $store;return $e}}
function Get-CoordinatorNextEvent{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[ValidateRange(1,3600)][int]$LeaseSeconds=60);Invoke-CoordinatorEventStoreLock $Path {param($full,$store)$now=[DateTime]::UtcNow;$changed=$false;foreach($e in @($store.events)){if($e.state -ceq 'claimed' -and $e.leaseUntilUtc -and [DateTimeOffset]::Parse([string]$e.leaseUntilUtc).UtcDateTime -le $now){$e.state='pending';$e.claimId=$null;$e.claimedAtUtc=$null;$e.leaseUntilUtc=$null;$changed=$true}};$e=@($store.events|Where-Object{$_.state -ceq 'pending' -and (Test-LCEventDue $_ ([DateTime]::UtcNow))}|Select-Object -First 1);if($e.Count -eq 0){if($changed){Write-CoordinatorEventStore $full $store};return $null};$claimId=[guid]::NewGuid().ToString('D');$item=$e[0];$item.state='claimed';$item.claimId=$claimId;$item.claimedAtUtc=$now.ToString('o');$item.leaseUntilUtc=$now.AddSeconds($LeaseSeconds).ToString('o');Write-CoordinatorEventStore $full $store;return $item}}
function Complete-CoordinatorEvent{[CmdletBinding()]param([Parameter(Mandatory=$true)][string]$Path,[Parameter(Mandatory=$true)][string]$EventId,[Parameter(Mandatory=$true)][string]$ClaimId);Invoke-CoordinatorEventStoreLock $Path {param($full,$store)$matches=@($store.events|Where-Object{$_.id -ceq $EventId});if($matches.Count -ne 1){throw 'EventNotFound'};$e=$matches[0];if($e.state -ceq 'acknowledged'){if($e.claimId -cne $ClaimId){throw 'EventClaimMismatch'};return $e};if($e.state -cne 'claimed' -or $e.claimId -cne $ClaimId){throw 'EventClaimMismatch'};$e.state='acknowledged';$e.acknowledgedAtUtc=[DateTime]::UtcNow.ToString('o');Write-CoordinatorEventStore $full $store;return $e}}
Export-ModuleMember -Function Save-CoordinatorEventFailure,Add-CoordinatorEvent,Publish-CoordinatorEvent,Get-CoordinatorPendingEvents,Get-CoordinatorNextEvent,Claim-CoordinatorEvent,Claim-CoordinatorEvents,Complete-CoordinatorEvent
