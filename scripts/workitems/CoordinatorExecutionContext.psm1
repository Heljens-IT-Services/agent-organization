. (Join-Path $PSScriptRoot '..\coordinator\Lifecycle.Persistence.ps1')
$ErrorActionPreference = 'Stop'
$script:ContextUtf8 = New-Object Text.UTF8Encoding($false,$true)
function Get-ContextHash([byte[]]$Bytes) { $sha=[Security.Cryptography.SHA256]::Create();try{return ([BitConverter]::ToString($sha.ComputeHash($Bytes))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()} }
function Get-ContextField($Value,[string]$Name) { if($Value -is [Collections.IDictionary]){return $Value[$Name]};$p=$Value.PSObject.Properties[$Name];if($p){return $p.Value};return $null }
function Read-ContextJson([string]$Path) { return ConvertFrom-Json -InputObject $script:ContextUtf8.GetString([IO.File]::ReadAllBytes($Path)) -ErrorAction Stop }
function Get-ExecutionJobHash($Job) { $i=[ordered]@{};foreach($n in @('task_id','role','parent_task_id','parent_job_path','parent_context_path','parent_context_hash','parent_thread_id','parent_turn_id','work_item_id','execution_id','work_item_store_path','accounting_directory','cwd','result_file','model','developer_instructions','config','sandbox','approval_policy','coordinator_launch','payload_hash')){$i[$n]=Get-ContextField $Job $n};Get-ContextHash $script:ContextUtf8.GetBytes((ConvertTo-Json -InputObject $i -Depth 50 -Compress)) }
function Save-ImmutableContext([string]$Directory,$Record) { [void][IO.Directory]::CreateDirectory($Directory);$b=$script:ContextUtf8.GetBytes((ConvertTo-Json -InputObject $Record -Depth 50 -Compress));$h=Get-ContextHash $b;$p=Join-Path $Directory ($h+'.json');try{$f=New-Object IO.FileStream($p,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None);try{$f.Write($b,0,$b.Length);$f.Flush($true)}finally{$f.Dispose()}}catch [IO.IOException]{if(-not [IO.File]::Exists($p)-or (Get-ContextHash ([IO.File]::ReadAllBytes($p))) -cne $h){throw}};[pscustomobject]@{path=$p;hash=$h;record=$Record} }
function New-ExecutionTurnContext { param([string]$Directory,[string]$JobPath,[string]$StorePath,[string]$ThreadId,[string]$TurnId,[string]$RequestId,[ValidateSet('Running','Completed','Failed','Interrupted')][string]$Outcome,[string]$SessionId,[string]$AuthorityHash,[string]$EvidenceHash);$j=Read-ContextJson $JobPath;foreach($x in @($ThreadId,$TurnId,$RequestId,$AuthorityHash,$EvidenceHash)){if([string]::IsNullOrWhiteSpace($x)){throw 'Missing real turn/authority evidence'}};if(-not $j.task_id -or -not $j.role -or -not $j.accounting_directory){throw 'Missing actual job'};$r=[ordered]@{kind='execution-turn-context-v1';jobPath=[IO.Path]::GetFullPath($JobPath);jobHash=(Get-ExecutionJobHash $j);taskId=[string]$j.task_id;role=[string]$j.role;workItemId=$j.work_item_id;storePath=[IO.Path]::GetFullPath($StorePath);accountingDirectory=[IO.Path]::GetFullPath($j.accounting_directory);threadId=$ThreadId;turnId=$TurnId;requestId=$RequestId;outcome=$Outcome;logicalSessionId=$SessionId;authorityHash=$AuthorityHash;evidenceHash=$EvidenceHash;parentContextPath=$j.parent_context_path;parentContextHash=$j.parent_context_hash};Save-ImmutableContext $Directory $r }
function Assert-ExecutionContext { param([string]$ContextPath,[string]$ContextHash,[string]$JobPath,[string]$TaskId,[string]$StorePath,[string]$AccountingDirectory,[switch]$RequireTerminal,[switch]$RequireLiveCoordinator);if((Get-ContextHash ([IO.File]::ReadAllBytes($ContextPath))) -cne $ContextHash){throw 'Historical ContextHash mismatch'};$c=Read-ContextJson $ContextPath;$j=Read-ContextJson $JobPath;if($c.kind -cne 'execution-turn-context-v1' -or $c.jobHash -cne (Get-ExecutionJobHash $j) -or $c.jobPath -cne [IO.Path]::GetFullPath($JobPath) -or $c.taskId -cne $TaskId -or $j.task_id -cne $TaskId -or $c.role -cne $j.role -or $c.workItemId -cne $j.work_item_id -or $c.storePath -cne [IO.Path]::GetFullPath($StorePath) -or $c.accountingDirectory -cne [IO.Path]::GetFullPath($AccountingDirectory) -or [IO.Path]::GetFullPath($j.accounting_directory) -cne $c.accountingDirectory -or [IO.Path]::GetFullPath($j.work_item_store_path) -cne $c.storePath -or $c.parentContextPath -cne $j.parent_context_path -or $c.parentContextHash -cne $j.parent_context_hash -or -not $c.threadId -or -not $c.turnId -or -not $c.authorityHash -or -not $c.evidenceHash){throw 'Historical context/job binding conflict'};if($RequireTerminal -and $c.outcome -cne 'Completed'){throw 'No successful immutable terminal parent turn'};if($RequireLiveCoordinator){$a=Read-ContextJson ($JobPath+'.active.json');if($j.role -cne 'koordinator' -or $j.parent_task_id -or $a.task_id -cne $TaskId -or $a.job_hash -cne $c.jobHash -or $a.thread_id -cne $c.threadId -or $a.store_path -cne $c.storePath -or $a.accounting_directory -cne $c.accountingDirectory -or $a.state -notin @('Ready','RunningTurn')){throw 'Coordinator job is not live/bound'}};return $c }
function Assert-ExecutionAncestors { param([string]$ContextPath,[string]$ContextHash,[string]$StorePath,[string]$AccountingDirectory,[int]$MaxLevels=3);$seen=@{};$n=0;while($ContextPath){if($seen.ContainsKey($ContextHash)){throw 'Context ancestry cycle'};$seen[$ContextHash]=$true;$raw=Read-ContextJson $ContextPath;$c=Assert-ExecutionContext $ContextPath $ContextHash $raw.jobPath $raw.taskId $StorePath $AccountingDirectory;$j=Read-ContextJson $c.jobPath;if(++$n -gt [Math]::Min(3,$MaxLevels)){throw 'More than allowed agent levels'};if($c.role -ceq 'koordinator'){if($j.parent_task_id -or $j.parent_job_path -or $c.parentContextPath -or $c.parentContextHash){throw 'Coordinator is not root'};return $c};if(-not $c.parentContextPath -or -not $c.parentContextHash -or -not $j.parent_task_id){throw 'Missing real ancestor context'};$p=Read-ContextJson $c.parentContextPath;if($j.parent_task_id -cne $p.taskId -or $j.parent_job_path -cne $p.jobPath -or $j.parent_thread_id -cne $p.threadId -or $j.parent_turn_id -cne $p.turnId -or $j.parent_context_path -cne $c.parentContextPath -or $j.parent_context_hash -cne $c.parentContextHash){throw 'Ancestor edge mismatch'};if($c.role -match '^teamleiter_' -and $p.role -cne 'koordinator'){throw 'Team leader parent is not the coordinator'};if($c.role -notmatch '^(koordinator|teamleiter_[a-z][a-z0-9_]*)$' -and ($p.role -notmatch '^teamleiter_(?<team>[a-z][a-z0-9_]*)$' -or $c.role -notlike ($Matches.team+'_ *').Replace(' ','') -or $c.role -match '^teamleiter_')){throw 'Operational role is outside its team leader ancestry'};$ContextPath=$c.parentContextPath;$ContextHash=$c.parentContextHash};throw 'Missing coordinator ancestor' }
function New-DelegatedStartAuthority { param([string]$Directory,[Collections.IDictionary]$Parameters,[string]$ParentJobPath,[string]$ParentContextPath,[string]$ParentContextHash,[string]$StoreRevision);foreach($k in @('Role','WorkItemId','ExecutionId','WorkItemStorePath','WorkItemRequestPath','Purpose','Generation','DispatchJournalPath','ParentTaskId','AccountingDirectory','StableTaskId','DispatchId','WorkingDirectory','ResultPath','CoordinatorDataDirectory','AdmissionCapacity','TimeoutSeconds','KeepWindowOpen','DetachedAfterVisibleAck')){if(-not $Parameters.Contains($k)){throw ('Missing start authority input '+$k)}};if($Parameters.Contains('Task') -or $Parameters.Contains('ContextFile')){throw 'SSOT forbids Task/ContextFile'};$job=Read-ContextJson $ParentJobPath;if($job.task_id -cne $Parameters.ParentTaskId -or $job.accounting_directory -cne $Parameters.AccountingDirectory -or $job.work_item_store_path -cne $Parameters.WorkItemStorePath){throw 'Start authority parent job binding mismatch'};$parent=Assert-ExecutionContext $ParentContextPath $ParentContextHash $ParentJobPath ([string]$Parameters.ParentTaskId) ([string]$Parameters.WorkItemStorePath) ([string]$Parameters.AccountingDirectory);if($job.role -ceq 'koordinator'){if($job.parent_task_id -or $job.parent_job_path -or $job.work_item_id -or $job.execution_id -or $parent.outcome -cne 'Completed'){throw 'Coordinator automation requires a completed real root context'};$parent=Assert-ExecutionContext $ParentContextPath $ParentContextHash $ParentJobPath ([string]$Parameters.ParentTaskId) ([string]$Parameters.WorkItemStorePath) ([string]$Parameters.AccountingDirectory) -RequireTerminal -RequireLiveCoordinator}else{if($job.role -notmatch '^teamleiter_[a-z][a-z0-9_]*$' -or $parent.outcome -ne 'Running'){throw 'Team leader delegation requires its real running ACK context'}};& (Get-Command Assert-ExecutionAncestors -CommandType Function) -ContextPath $ParentContextPath -ContextHash $ParentContextHash -StorePath $Parameters.WorkItemStorePath -AccountingDirectory $Parameters.AccountingDirectory|Out-Null;$assessment=[string](Get-ContextField $Parameters 'ResumeAssessment');if($assessment){$storeModule=Import-Module (Join-Path $PSScriptRoot 'WorkItemStore.psm1') -PassThru -Force;$snap=& $storeModule {param($p,$root)Get-WorkItemStoreResult -Path $p -RepositoryRoot $root} $Parameters.WorkItemStorePath (Split-Path -Parent (Split-Path -Parent $PSScriptRoot));$i=@($snap.Document.items|Where-Object{$_.id -ceq $Parameters.WorkItemId});if($i.Count -ne 1){throw 'AuthorityResumeItemAmbiguous'};$r=Assert-LCResume $assessment $i[0] $snap.Revision $Parameters.WorkItemStorePath (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) -BeforeCAS;if($r.nextExecutionId -cne $Parameters.ExecutionId -or [int]$r.generation -ne [int]$Parameters.Generation){throw 'AuthorityResumeGenerationConflict'}};$locator=[ordered]@{kind='request';workItemId=$Parameters.WorkItemId;executionId=$Parameters.ExecutionId};$b=$script:ContextUtf8.GetBytes((ConvertTo-Json -InputObject $locator -Compress));$r=[ordered]@{kind='delegated-start-authority-v1';parameters=$Parameters;parentJobPath=[IO.Path]::GetFullPath($ParentJobPath);parentJobHash=(Get-ExecutionJobHash $job);parentContextPath=[IO.Path]::GetFullPath($ParentContextPath);parentContextHash=$ParentContextHash;parentThreadId=$parent.threadId;parentTurnId=$parent.turnId;storeRevision=$StoreRevision;requestPayloadBase64=[Convert]::ToBase64String($b);requestPayloadHash=(Get-ContextHash $b)};Save-ImmutableContext $Directory $r }
function Read-DelegatedStartAuthority([string]$Path,[string]$Hash){if((Get-ContextHash ([IO.File]::ReadAllBytes($Path))) -cne $Hash){throw 'Start payload conflict'};$r=Read-ContextJson $Path;if($r.kind -cne 'delegated-start-authority-v1'){throw 'Unsupported start authority'};return $r}
Export-ModuleMember -Function Get-ContextHash,Get-ContextField,Read-ContextJson,Get-ExecutionJobHash,Save-ImmutableContext,New-ExecutionTurnContext,Assert-ExecutionContext,Assert-ExecutionAncestors,New-DelegatedStartAuthority,Read-DelegatedStartAuthority

